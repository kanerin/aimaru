{
  "compilerOptions": {
    "module": "commonjs",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "outDir": "lib",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": ["src"],
  "//": "テストはデプロイ成果物に含めない。型チェックは tsconfig.test.json 側で行う",
  "exclude": ["src/**/*.test.ts", "src/**/*.integration.test.ts"]
}
