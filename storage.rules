rules_version = '2';

// カップルの写真は、このアプリで最もプライベートなデータ。
// couples/{coupleId}/ 配下は、そのカップルのメンバーだけが読み書きできる。
//
// メンバー判定は Firestore の couples ドキュメントを参照して行う。
// Storage 単体では「誰がどのカップルか」を知る手段が無いため。
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid in firestore.get(
          /databases/(default)/documents/couples/$(coupleId)
        ).data.memberIds;
    }

    // バグ報告・機能要望フォームに添付する画像。reportIdはsubmitBugReport
    // （Cloud Functions）が受理した報告に対して発行したFirestoreドキュメントID
    // なので、そのドキュメントのcreatedByと一致する本人だけがアップロード・
    // 閲覧できる（他人の報告IDへ画像を投げ込めないようにするための境界）。
    match /bugReports/{reportId}/{allPaths=**} {
      allow read, write: if request.auth != null &&
        request.auth.uid == firestore.get(
          /databases/(default)/documents/bugReports/$(reportId)
        ).data.createdBy;
    }

    // 上記以外のパスは誰も触れない。書き込み先を couples/ 配下に限定することで、
    // アプリの外から任意の場所へファイルを置かれるのを防ぐ。
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
