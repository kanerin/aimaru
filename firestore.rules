rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{coupleId} {
      // 読み取り: 認証済みユーザーなら可。
      // 招待コード検索（inviteCodeフィールドでのクエリ）は memberIds を
      // フィルタ条件に含められないため、resource.data.memberIds による
      // 絞り込みだとルール評価自体が失敗してしまう（常に拒否される）。
      // データの安全性は書き込み側（create/update/delete）で担保する。
      allow read: if request.auth != null;
      // 注意: create時は resource がまだ存在せず null になるため、
      // resource.data ではなく request.resource.data で判定すること
      allow delete: if request.auth.uid in resource.data.memberIds;
      allow create: if request.auth.uid in request.resource.data.memberIds;
      // 更新: 既存メンバー、または招待コードで参加しようとしている2人目（定員2名未満）
      allow update: if request.auth.uid in resource.data.memberIds
        || (request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.size() < 2);

      match /events/{eventId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /chats/{msgId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /todos/{todoId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /anniversaries/{anniversaryId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      // デイリー質問への回答（ドキュメントID = '${dateKey}_$uid'）。
      // メンバーなら誰でも読めるが、書き込みは自分の回答のみ。相手の回答を
      // 見た後に自分の回答を書き換えられないよう、更新・削除も許可しない。
      match /questionAnswers/{answerId} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow create: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds
          && request.auth.uid == request.resource.data.uid;
      }

      // Googleカレンダーのキャッシュ（ドキュメントID = uid）。
      // メンバーなら誰でも読めるが、書き込みは自分の分のみ。
      match /googleCalendarCache/{uid} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow write: if request.auth.uid == uid && request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth.uid == userId;
      // aiCallDate/aiCallCountはaskGemini（Cloud Functions、Admin SDK経由で
      // ここを迂回する）が1日あたりのAI呼び出し回数を数えるための場所。
      // ここを他フィールドと同列に書き込み自由にすると、クライアントが
      // 直接自分のカウントを0へ書き戻してレート制限を無効化できてしまう。
      // set(..., {merge:true})では変更していない既存フィールドも
      // request.resource.dataに含まれてくるため、変更されたキーだけを見る
      // diff().affectedKeys()で判定する（keys()だけで見ると、一度でも
      // これらのフィールドが立った後は無関係な設定変更まで拒否されてしまう）。
      allow create, update: if request.auth.uid == userId &&
        (resource == null
          ? !request.resource.data.keys().hasAny(['aiCallDate', 'aiCallCount'])
          : !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['aiCallDate', 'aiCallCount']));
    }
  }
}
