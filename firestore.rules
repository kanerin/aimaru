rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{coupleId} {
      // 読み取り: メンバーのみ。招待コード検索は別コレクション
      // （inviteCodes、下記）を経由するため、ここをメンバー以外に
      // 開ける理由はもう無い（2026-08-22、旧TC-072の妥協を解消）。
      allow read: if request.auth.uid in resource.data.memberIds;
      // 注意: create時は resource がまだ存在せず null になるため、
      // resource.data ではなく request.resource.data で判定すること
      allow delete: if request.auth.uid in resource.data.memberIds;
      allow create: if request.auth.uid in request.resource.data.memberIds;
      // 更新: 既存メンバー、または招待コードで参加しようとしている2人目（定員2名未満）
      allow update: if request.auth.uid in resource.data.memberIds
        || (request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.size() < 2);

      // 課題3（予定ごとの共有範囲）フェーズ2: visibility == 'private' の予定は
      // 作成者本人にしか見せない。既存ドキュメント（フィールド自体が無い）は
      // 存在しないマップキーへの `.` アクセスがルール評価エラーになるため、
      // 必ず get('visibility', 'shared') で読み、無ければsharedとして扱う
      // （Dart側 AimaruEvent.fromDoc のフォールバックと合わせている）。
      match /events/{eventId} {
        function isMember() {
          return request.auth.uid in
            get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        }
        function canSeeExisting() {
          return resource.data.get('visibility', 'shared') != 'private'
            || resource.data.createdBy == request.auth.uid;
        }

        allow read, delete: if isMember() && canSeeExisting();
        // createdByは作成者の固定値として使う（visibilityの可視性判定の土台のため）。
        // 更新時に書き換えられると、後から誰でも「自分のprivateな予定」に
        // 差し替えられてしまうので、更新では変更不可にする。
        allow update: if isMember() && canSeeExisting()
          && request.resource.data.createdBy == resource.data.createdBy;
        allow create: if isMember()
          && request.resource.data.createdBy == request.auth.uid;
      }

      match /chats/{msgId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /todos/{todoId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /anniversaries/{anniversaryId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      // デイリー質問への回答（ドキュメントID = '${dateKey}_$uid'）。
      // メンバーなら誰でも読めるが、書き込みは自分の回答のみ。相手の回答を
      // 見た後に自分の回答を書き換えられないよう、更新・削除も許可しない。
      match /questionAnswers/{answerId} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow create: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds
          && request.auth.uid == request.resource.data.uid;
      }

      // Googleカレンダーのキャッシュ（ドキュメントID = uid）。
      // メンバーなら誰でも読めるが、書き込みは自分の分のみ。
      match /googleCalendarCache/{uid} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow write: if request.auth.uid == uid && request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }
    }

    // 招待コード参加フローの事前確認専用。coupleIdと参加者のuidだけを
    // ミラーする（ドキュメントID = コード自体）。anniversary等の実データは
    // ここには置かないため、多少ルールが緩くても実害は小さい。
    // 本当の安全性は couples 側の create/update ルールが最終防衛線として
    // 別途担っており、ここが不整合を起こしても couples 側で弾かれる
    // （例: memberIdsを不正に2件のまま偽装しても、実際のjoinは
    // couples.updateのresource.data.memberIds.size() < 2で別途判定される）。
    match /inviteCodes/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds.size() == 1;
      allow update: if request.auth.uid in request.resource.data.memberIds
        && resource.data.memberIds.size() < 2
        && request.resource.data.coupleId == resource.data.coupleId;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow delete: if request.auth.uid == userId;
      // aiCallDate/aiCallCountはaskGemini（1日あたり）、
      // reportCallMonth/reportCallCountはsubmitBugReport（1ヶ月あたり）が
      // それぞれの呼び出し回数を数えるための場所（どちらもCloud Functions、
      // Admin SDK経由でここを迂回する）。ここを他フィールドと同列に書き込み
      // 自由にすると、クライアントが直接自分のカウントを0へ書き戻して
      // レート制限を無効化できてしまう。set(..., {merge:true})では
      // 変更していない既存フィールドもrequest.resource.dataに含まれてくる
      // ため、変更されたキーだけを見るdiff().affectedKeys()で判定する
      // （keys()だけで見ると、一度でもこれらのフィールドが立った後は
      // 無関係な設定変更まで拒否されてしまう）。
      allow create, update: if request.auth.uid == userId &&
        (resource == null
          ? !request.resource.data.keys().hasAny(
              ['aiCallDate', 'aiCallCount', 'reportCallMonth', 'reportCallCount'])
          : !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['aiCallDate', 'aiCallCount', 'reportCallMonth', 'reportCallCount']));
    }

    // バグ報告・機能要望はsubmitBugReport（Cloud Functions、Admin SDK）からのみ
    // 書き込む。Gemini判定を経ずにクライアントから直接キューへ書き込めると、
    // 分類チェックそのものを迂回できてしまうため、クライアントには
    // 読み書きどちらも一切許可しない（一覧を見せるUIも現状無い）。
    match /bugReports/{reportId} {
      // 送信者本人だけが自分の報告の状況を確認できる。書き込みは引き続き
      // submitBugReport（Cloud Functions、Admin SDK）からのみ行う。
      allow read: if request.auth.uid == resource.data.createdBy;
      allow write: if false;
    }
  }
}
