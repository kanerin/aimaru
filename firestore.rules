rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /couples/{coupleId} {
      // 読み取り: 認証済みユーザーなら可。
      // 招待コード検索（inviteCodeフィールドでのクエリ）は memberIds を
      // フィルタ条件に含められないため、resource.data.memberIds による
      // 絞り込みだとルール評価自体が失敗してしまう（常に拒否される）。
      // データの安全性は書き込み側（create/update/delete）で担保する。
      allow read: if request.auth != null;
      // 注意: create時は resource がまだ存在せず null になるため、
      // resource.data ではなく request.resource.data で判定すること
      allow delete: if request.auth.uid in resource.data.memberIds;
      allow create: if request.auth.uid in request.resource.data.memberIds;
      // 更新: 既存メンバー、または招待コードで参加しようとしている2人目（定員2名未満）
      allow update: if request.auth.uid in resource.data.memberIds
        || (request.auth.uid in request.resource.data.memberIds
            && resource.data.memberIds.size() < 2);

      match /events/{eventId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /chats/{msgId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /todos/{todoId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      match /expenses/{expenseId} {
        allow read, write: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }

      // Googleカレンダーのキャッシュ（ドキュメントID = uid）。
      // メンバーなら誰でも読めるが、書き込みは自分の分のみ。
      match /googleCalendarCache/{uid} {
        allow read: if request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
        allow write: if request.auth.uid == uid && request.auth.uid in
          get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
      }
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
  }
}
