# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Cloud Functions
/functions/node_modules/
/functions/lib/

# ローカルの秘密情報（APIキー・署名鍵・サービスアカウント鍵など）。
# 絶対にコミットしない。CIではGitHub Secretsを使う。
*.keystore
*.jks
key.properties
**/serviceAccountKey*.json
**/play-store-service-account*.json
firestore-debug.log

# Firebase設定ファイル（APIキーを含むため公開リポジトリに置かない）。
# CIでは FIREBASE_OPTIONS_DART_BASE64 / GOOGLE_SERVICES_JSON_BASE64 という
# GitHub Secretsから復元する（README「Firebase設定ファイルの非公開化」参照）。
# ローカルでは `flutterfire configure` を再実行するか、安全な方法（パスワード
# マネージャーの添付ファイル機能など）でコピーして入手すること。
/android/app/google-services.json
/ios/Runner/GoogleService-Info.plist
/lib/firebase_options.dart

# Claude Code のローカル状態（このマシン固有、別セッション/スケジュールタスクが生成）
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.lock

# セキュリティルールのテスト
rules_test/node_modules/
firebase-debug.log
firestore-debug.log
ui-debug.log
